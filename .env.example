# Copy to .env.local (not committed) and fill in per environment.
# NEXT_PUBLIC_* values are built into the static export: change them, then rebuild.

# Bhashini live translation endpoint.
# Leave empty to use the default public plugin endpoint (the one vistaar.da.gov.in uses):
#   https://translation-plugin.bhashini.co.in/v2/translate-text
# Set this if Bhashini issues a dedicated endpoint for this site.
NEXT_PUBLIC_BHASHINI_TRANSLATE_URL=
